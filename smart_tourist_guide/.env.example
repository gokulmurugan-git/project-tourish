# Smart Tourist Guide - Environment Variables
# Copy this file to .env and fill in your keys.

# Gemini AI API Key (Required for AI Trip Planner and AI Tourist Assistant)
GEMINI_API_KEY="your-gemini-api-key-here"

# Firebase Admin Configuration (Optional for Firestore cloud sync)
FIREBASE_PROJECT_ID="your-firebase-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxx@your-project-id.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Firebase Client Web Config (Public keys for frontend Firebase Auth)
FIREBASE_WEB_API_KEY="your-web-api-key"
FIREBASE_AUTH_DOMAIN="your-project-id.firebaseapp.com"
FIREBASE_STORAGE_BUCKET="your-project-id.appspot.com"
FIREBASE_MESSAGING_SENDER_ID="your-sender-id"
FIREBASE_APP_ID="your-app-id"

# Maps API Key (Optional: Map uses Leaflet + OpenStreetMap tiles out of the box with zero key needed)
MAP_API_KEY=""

# Flask Server Config
SECRET_KEY="smart-tourist-guide-super-secret-key-change-in-production"
FLASK_ENV="development"
PORT=3000
